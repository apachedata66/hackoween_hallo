# Variable NAMES only. Never put real values in this file or in git.
# Copy to .env locally if a tool reads it; .env is gitignored.

# Optional in development: path to a local copy of the challenge dataset.
# This repository keeps dataset/ out of git, so a team checkout points at
# the official challenge checkout instead. Leave empty to use the contract
# default <repo root>/dataset.
GHOSTDATA_DATASET=

# Reserved for later phases (OCR/vision only if the deterministic path is
# not enough). The core audit is stdlib-only and needs none of these.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
